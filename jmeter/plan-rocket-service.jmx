        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/insumos/listar" enabled="true">
          <stringProp name="HTTPSampler.path">/api/insumos/listar</stringProp>
