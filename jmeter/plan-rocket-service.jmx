        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/unidad_de_medida/listar" enabled="true">
          <stringProp name="HTTPSampler.path">/api/unidad_de_medida/listar</stringProp>
