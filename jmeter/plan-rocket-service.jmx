        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/imagenes_danos/listar" enabled="true">
          <stringProp name="HTTPSampler.path">/api/imagenes_danos/listar</stringProp>
