        <!-- 10. RNF-001: VALIDACIÓN DE SEGURIDAD JWT (ADMIN DATA) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/auth/admin-data (Rol Admin)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/auth/admin-data</stringProp>
